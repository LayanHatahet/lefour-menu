{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/seo?f=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?f=sitemap"
    },
    {
      "source": "/fr",
      "destination": "/"
    },
    {
      "source": "/en",
      "destination": "/"
    },
    {
      "source": "/ar",
      "destination": "/"
    },
    {
      "source": "/menu",
      "destination": "/"
    },
    {
      "source": "/traiteur",
      "destination": "/"
    },
    {
      "source": "/catering",
      "destination": "/"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/galerie",
      "destination": "/"
    },
    {
      "source": "/commander",
      "destination": "/"
    },
    {
      "source": "/order",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
