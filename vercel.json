{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/fr", "destination": "/index.html" },
    { "source": "/en", "destination": "/index.html" },
    { "source": "/ar", "destination": "/index.html" },
    { "source": "/menu", "destination": "/index.html" },
    { "source": "/traiteur", "destination": "/index.html" },
    { "source": "/catering", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/galerie", "destination": "/index.html" },
    { "source": "/commander", "destination": "/index.html" },
    { "source": "/order", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
